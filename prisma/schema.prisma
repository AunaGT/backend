// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========================================
// Multi-empresa y sucursales
// ========================================

/// Empresa (tenant). Cada empresa tiene su propio catálogo, precios,
/// proveedores, clientes, contabilidad y sucursales. Los usuarios pueden
/// pertenecer a varias empresas (UserCompany).
model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String   @db.VarChar(150)
  code       String   @unique @db.VarChar(20)
  /// NIT / ID fiscal para membretes y DTE
  tax_id     String?  @db.VarChar(100)
  address    String?  @db.Text
  phone      String?  @db.VarChar(50)
  logo_url   String?  @db.VarChar(500)
  active     Boolean  @default(true)
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  branches           Branch[]
  user_companies     UserCompany[]
  products           Product[]
  product_categories ProductCategory[]
  suppliers          Supplier[]
  payment_terms      PaymentTerm[]
  promotions         Promotion[]
  promotion_codes    PromotionCode[]
  system_settings    SystemSetting[]
  accounts           Account[]
  accounting_periods AccountingPeriod[]
  journal_entries    JournalEntry[]
  employees          Employee[]
  attendance         Attendance[]
  employee_advances  EmployeeAdvance[]
  payroll_runs       PayrollRun[]

  @@map("companies")
}

/// Pertenencia usuario ↔ empresa (N a N). El email del usuario es único global.
model UserCompany {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String   @db.Uuid
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([user_id, company_id])
  @@index([company_id])
  @@map("user_companies")
}

/// Sucursal. Toda entidad transaccional lleva branch_id; la empresa se deriva
/// de la sucursal.
model Branch {
  id                String         @id @default(uuid()) @db.Uuid
  company_id        String         @db.Uuid
  company           Company        @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name              String         @db.VarChar(150)
  /// Código corto para referencias de documentos: "SUC1"
  code              String         @db.VarChar(10)
  /// Secuencia global estable para derivar advisory lock keys de numeración
  seq               Int            @unique @default(autoincrement())
  address           String?        @db.Text
  phone             String?        @db.VarChar(50)
  active            Boolean        @default(true)
  is_default        Boolean        @default(false)
  /// Ubicación de la que despacha el punto de venta de esta sucursal. Si es
  /// null, la venta sale por prioridad de despacho como cualquier otra salida.
  sales_location_id String?        @db.Uuid
  sales_location    StockLocation? @relation("BranchSalesLocation", fields: [sales_location_id], references: [id], onDelete: SetNull)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_branches            UserBranch[]
  users_default            User[]                  @relation("UserDefaultBranch")
  product_stocks           ProductStock[]
  product_lots             ProductLot[]
  alerts                   Alert[]
  sales                    Sale[]
  commercial_documents     CommercialDocument[]
  stock_reservations       StockReservation[]
  incoming_merchandise     IncomingMerchandise[]
  inventory_count_sessions InventoryCountSession[]
  cash_registers           CashRegister[]
  cash_closures            CashClosure[]
  customer_payments        CustomerPayment[]
  transfers_out            StockTransfer[]         @relation("TransferFromBranch")
  transfers_in             StockTransfer[]         @relation("TransferToBranch")
  journal_entries          JournalEntry[]
  promotions               PromotionBranch[]
  warehouses               Warehouse[]
  stock_movements          StockMovement[]
  employees                Employee[]
  attendance               Attendance[]
  employee_advances        EmployeeAdvance[]
  payroll_runs             PayrollRun[]

  @@unique([company_id, code])
  @@map("branches")
}

/// Asignación usuario ↔ sucursal (N a N).
model UserBranch {
  user_id    String   @db.Uuid
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  branch_id  String   @db.Uuid
  branch     Branch   @relation(fields: [branch_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())

  @@id([user_id, branch_id])
  @@index([branch_id])
  @@map("user_branches")
}

/// Stock por sucursal: la verdad para vender. `products.stock` queda como
/// espejo (suma de sucursales) durante la transición.
model ProductStock {
  id         String  @id @default(uuid()) @db.Uuid
  product_id String  @db.Uuid
  product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  branch_id  String  @db.Uuid
  branch     Branch  @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  stock      Int     @default(0)
  min_stock  Int     @default(0)

  @@unique([product_id, branch_id])
  @@index([branch_id])
  @@map("product_stocks")
}

enum WarehouseKind {
  BODEGA
  SALA_VENTAS
  VITRINA
  TRANSITO
  OTRO
}

/// Espacio físico dentro de una sucursal: bodega, sala de ventas, vitrina, tránsito.
model Warehouse {
  id                String        @id @default(uuid()) @db.Uuid
  branch_id         String        @db.Uuid
  branch            Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  name              String        @db.VarChar(120)
  code              String        @db.VarChar(20)
  kind              WarehouseKind @default(BODEGA)
  /// Almacén al que caen las operaciones que no eligen uno (ventas, ingresos, devoluciones).
  is_default        Boolean       @default(false)
  /// Recibe la mercancía de proveedores y de traslados entrantes.
  is_receiving      Boolean       @default(false)
  /// Orden en que se descuenta al vender: menor primero.
  dispatch_priority Int           @default(100)
  active            Boolean       @default(true)
  notes             String?       @db.Text

  locations      StockLocation[]
  count_sessions InventoryCountSession[]
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt

  @@unique([branch_id, code])
  @@index([branch_id, active])
  @@map("warehouses")
}

/// Posición dentro del almacén. Si no se quiere ese detalle, basta la ubicación
/// por defecto, que siempre existe.
model StockLocation {
  id                String    @id @default(uuid()) @db.Uuid
  warehouse_id      String    @db.Uuid
  warehouse         Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Restrict)
  code              String    @db.VarChar(30)
  name              String?   @db.VarChar(120)
  is_default        Boolean   @default(false)
  /// Si es false no se despacha desde aquí (cuarentena, producto dañado).
  pickable          Boolean   @default(true)
  dispatch_priority Int       @default(100)
  active            Boolean   @default(true)

  stocks         ProductStockLocation[]
  movements      StockMovement[]
  count_lines    InventoryCountLine[]
  lots           ProductLot[]
  /// Sucursales que venden desde aquí (su punto de venta despacha de esta ubicación).
  sales_branches Branch[]               @relation("BranchSalesLocation")
  created_at     DateTime               @default(now())

  @@unique([warehouse_id, code])
  @@index([warehouse_id, active])
  @@map("stock_locations")
}

/// Existencias por ubicación: la verdad física. `product_stocks` queda como
/// espejo por sucursal y `products.stock` como espejo de empresa.
model ProductStockLocation {
  id          String        @id @default(uuid()) @db.Uuid
  product_id  String        @db.Uuid
  product     Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  location_id String        @db.Uuid
  location    StockLocation @relation(fields: [location_id], references: [id], onDelete: Restrict)
  stock       Int           @default(0)
  /// Punto de reposición interno (bodega → sala). No sustituye a
  /// product_stocks.min_stock, que sigue siendo el mínimo de compra por sucursal.
  min_stock   Int           @default(0)

  @@unique([product_id, location_id])
  @@index([location_id])
  @@map("product_stock_locations")
}

enum StockMovementReason {
  INITIAL
  PURCHASE
  SALE
  SALE_RETURN
  ORDER_FULFILL
  TRANSFER_OUT
  TRANSFER_IN
  TRANSFER_CANCEL
  INTERNAL_MOVE
  COUNT_ADJUST
  MANUAL_ADJUST
  KIT_ASSEMBLE
  KIT_DISASSEMBLE
}

/// Una fila por (producto, ubicación, delta). Append-only: nunca se edita ni se borra.
model StockMovement {
  id          String              @id @default(uuid()) @db.Uuid
  branch_id   String              @db.Uuid
  branch      Branch              @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  location_id String              @db.Uuid
  location    StockLocation       @relation(fields: [location_id], references: [id], onDelete: Restrict)
  product_id  String              @db.Uuid
  product     Product             @relation(fields: [product_id], references: [id], onDelete: Restrict)
  /// Signo incluido: negativo sale, positivo entra.
  qty         Int
  /// Existencia de la ubicación DESPUÉS del movimiento (kardex sin recalcular).
  balance     Int
  reason      StockMovementReason
  /// Documento que lo originó: 'sale' | 'transfer' | 'incoming_merchandise' | ...
  ref_type    String?             @db.VarChar(30)
  ref_id      String?             @db.Uuid
  /// Agrupa las líneas de una misma operación.
  group_id    String?             @db.Uuid
  notes       String?             @db.VarChar(300)
  created_by  String?             @db.Uuid
  createdBy   User?               @relation(fields: [created_by], references: [id], onDelete: SetNull)
  created_at  DateTime            @default(now())

  @@index([branch_id, created_at(sort: Desc)])
  @@index([product_id, created_at(sort: Desc)])
  @@index([location_id, created_at(sort: Desc)])
  @@index([ref_type, ref_id])
  @@index([group_id])
  @@map("stock_movements")
}

enum StockTransferStatus {
  EN_TRANSITO
  RECIBIDA
  CANCELADA
}

/// Traslado de mercancía entre sucursales de la misma empresa, en dos pasos:
/// envío (resta en origen) → recepción (suma en destino). Lo enviado y no
/// recibido queda como faltante de tránsito.
model StockTransfer {
  id             String              @id @default(uuid()) @db.Uuid
  reference      String              @db.VarChar(30) // T-SUC1-000001
  from_branch_id String              @db.Uuid
  fromBranch     Branch              @relation("TransferFromBranch", fields: [from_branch_id], references: [id], onDelete: Restrict)
  to_branch_id   String              @db.Uuid
  toBranch       Branch              @relation("TransferToBranch", fields: [to_branch_id], references: [id], onDelete: Restrict)
  status         StockTransferStatus @default(EN_TRANSITO)
  created_by     String              @db.Uuid
  createdBy      User                @relation("TransferCreatedBy", fields: [created_by], references: [id], onDelete: Restrict)
  sent_at        DateTime            @default(now())
  received_by    String?             @db.Uuid
  receivedBy     User?               @relation("TransferReceivedBy", fields: [received_by], references: [id], onDelete: SetNull)
  received_at    DateTime?
  cancelled_at   DateTime?
  notes          String?             @db.Text
  lines          StockTransferLine[]

  @@unique([from_branch_id, reference])
  @@index([to_branch_id, status])
  @@index([from_branch_id, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id            String        @id @default(uuid()) @db.Uuid
  transfer_id   String        @db.Uuid
  transfer      StockTransfer @relation(fields: [transfer_id], references: [id], onDelete: Cascade)
  product_id    String        @db.Uuid
  product       Product       @relation(fields: [product_id], references: [id], onDelete: Restrict)
  qty_sent      Int
  qty_received  Int?
  /// Lotes consumidos en el origen al enviar: [{ lot_code, expiry_date, unit_cost, supplier_id, qty }].
  /// Al recibir se recrean en el destino; al cancelar se devuelven al origen.
  lots_snapshot Json?

  @@index([transfer_id])
  @@index([product_id])
  @@map("stock_transfer_lines")
}

// ========================================
// Catálogos
// ========================================

model ProductCategory {
  id                   Int                 @id @default(autoincrement())
  company_id           String              @db.Uuid
  company              Company             @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name                 String              @db.VarChar(100)
  image_url            String?             @db.VarChar(500)
  deleted              Boolean             @default(false)
  products             Product[]
  suppliers            SupplierCategory[]
  promotion_categories PromotionCategory[]

  @@unique([company_id, name])
  @@map("product_categories")
}

model Status {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(50)
  alerts Alert[]

  @@map("statuses")
}

model StockStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(50)
  products Product[]

  @@map("stock_statuses")
}

enum ProductKind {
  STANDARD
  KIT
}

/// Tipo de devolución: REFUND regresa dinero; EXCHANGE cambia por otro producto.
enum ReturnType {
  REFUND
  EXCHANGE
}

model PaymentMethod {
  id                    Int                  @id @default(autoincrement())
  name                  String               @unique @db.VarChar(50)
  /// Venta a crédito: no entra dinero al cobrar, genera cuenta por cobrar.
  /// Es bandera y no un match por nombre porque «Crédito 30d» o un typo
  /// mandaban la venta a Bancos en silencio (ver cashOrBank en postingEngine).
  is_credit             Boolean              @default(false)
  sales                 Sale[]
  customer_payments     CustomerPayment[]
  cash_closure_payments CashClosurePayment[] // Relación para saber qué método de pago se usó en cada línea del cierre

  @@map("payment_methods")
}

/// Estado de cobro de una venta al crédito (cuentas por cobrar)
enum SalePaymentStatus {
  PENDING
  /// Hay abonos pero aún no cubren el total
  PARTIAL
  PAID
}

model SaleStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  sales Sale[]

  @@map("sale_statuses")
}

model ReturnStatus {
  id      Int      @id @default(autoincrement())
  name    String   @unique @db.VarChar(50)
  returns Return[]

  @@map("return_statuses")
}

model PaymentTerm {
  id                     Int                   @id @default(autoincrement())
  company_id             String                @db.Uuid
  company                Company               @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name                   String                @db.VarChar(50)
  /// Días naturales desde la fecha del ingreso hasta el vencimiento (opcional; sugiere due_date automática)
  net_days               Int?
  deleted                Boolean               @default(false)
  supplier_payment_terms SupplierPaymentTerm[]
  incoming_merchandise   IncomingMerchandise[]

  @@unique([company_id, name])
  @@map("payment_terms")
}

/// Estado de pago del ingreso de mercancía (cuentas por pagar)
enum MerchandisePaymentStatus {
  PENDING
  /// Hay abonos pero aún no cubren el total
  PARTIAL
  PAID
}

model AlertType {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(50)
  alerts Alert[]

  @@map("alert_types")
}

model AlertPriority {
  id     Int     @id @default(autoincrement())
  name   String  @unique @db.VarChar(50)
  alerts Alert[]

  @@map("alert_priorities")
}

// ========================================
// Entidades principales
// ========================================

enum SupplierPartyType {
  SUPPLIER
  CUSTOMER
}

/// Persona física vs empresa (razón social) para facturación y UI
enum ContactEntityKind {
  PERSON
  ORGANIZATION
}

/// Lista = precio base (`products.price`); mayoreo y promoción son columnas opcionales del producto.
enum PriceTier {
  LIST
  WHOLESALE
  PROMOTION
}

/// Canal de venta para reglas de precio y auditoría en `sales`.
enum SalesChannel {
  POS
  WHOLESALE
  ONLINE
}

model Supplier {
  id                     String                @id @default(uuid()) @db.Uuid
  company_id             String                @db.Uuid
  company                Company               @relation(fields: [company_id], references: [id], onDelete: Restrict)
  /// Proveedor (compras / productos) o cliente (maestro de ventas)
  party_type             SupplierPartyType     @default(SUPPLIER)
  /// Persona individual o empresa (nombre = razón social o nombre completo según tipo)
  entity_kind            ContactEntityKind     @default(ORGANIZATION)
  name                   String                @db.VarChar(150)
  contact                String                @db.VarChar(100)
  phone                  String?               @db.VarChar(50)
  email                  String?               @db.VarChar(150)
  address                String?               @db.Text
  /// ID fiscal para facturación (NIT, VAT, RFC, EIN, etc.; formato según país)
  tax_id                 String?               @db.VarChar(100)
  products               Int                   @default(0)
  last_order             DateTime?
  total_purchases        Decimal               @default(0) @db.Decimal(12, 2)
  rating                 Decimal?              @db.Decimal(3, 2)
  estado                 Int                   @default(1) // 0 = inactivo, 1 = activo
  supplier_payment_terms SupplierPaymentTerm[]
  categories             SupplierCategory[]
  productsList           Product[]
  purchase_logs          PurchaseLog[]
  incoming_merchandise   IncomingMerchandise[]
  deleted                Boolean               @default(false)
  deleted_at             DateTime?
  /// Precio por defecto si no hay regla `CustomerPriceRule` que aplique (solo clientes).
  default_price_tier     PriceTier             @default(LIST)
  /// Tope de saldo al crédito (solo clientes). null = sin límite.
  credit_limit           Decimal?              @db.Decimal(12, 2)
  customer_price_rules   CustomerPriceRule[]
  linked_sales           Sale[]                @relation("SaleCustomerContact")
  customer_payments      CustomerPayment[]
  commercial_documents   CommercialDocument[]  @relation("CommercialDocCustomer")

  /// Listado de contactos: party_type + orden por nombre (reemplaza índice solo party_type)
  @@index([party_type, name], map: "idx_suppliers_party_type_name")
  @@index([company_id, party_type])
  @@map("suppliers")
}

/// Reglas de lista de precios por cliente: canal opcional (null = todos) y prioridad descendente.
model CustomerPriceRule {
  id          String        @id @default(uuid()) @db.Uuid
  supplier_id String        @db.Uuid
  supplier    Supplier      @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  channel     SalesChannel?
  price_tier  PriceTier
  priority    Int           @default(0)
  active      Boolean       @default(true)
  created_at  DateTime      @default(now())

  @@index([supplier_id, active])
  @@map("customer_price_rules")
}

/// Varios términos de pago por contacto; exactamente uno con is_default = true (validado en API)
model SupplierPaymentTerm {
  supplier_id     String      @db.Uuid
  supplier        Supplier    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  payment_term_id Int
  payment_term    PaymentTerm @relation(fields: [payment_term_id], references: [id], onDelete: Restrict)
  is_default      Boolean     @default(false)
  sort_order      Int         @default(0)

  @@id([supplier_id, payment_term_id])
  @@index([payment_term_id])
  @@map("supplier_payment_terms")
}

model Product {
  id                         String                    @id @default(uuid()) @db.Uuid
  company_id                 String                    @db.Uuid
  company                    Company                   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name                       String                    @db.VarChar(150)
  category_id                Int
  category                   ProductCategory           @relation(fields: [category_id], references: [id])
  brand                      String?                   @db.VarChar(100)
  size                       String?                   @db.VarChar(50)
  stock                      Int                       @default(0)
  min_stock                  Int                       @default(0)
  price                      Decimal                   @db.Decimal(12, 2)
  price_wholesale            Decimal?                  @db.Decimal(12, 2)
  price_promotion            Decimal?                  @db.Decimal(12, 2)
  promotion_valid_until      DateTime?
  cost                       Decimal                   @db.Decimal(12, 2)
  image_url                  String?                   @db.VarChar(500)
  supplier_id                String                    @db.Uuid
  supplier                   Supplier                  @relation(fields: [supplier_id], references: [id])
  barcode                    String?                   @db.VarChar(100)
  /// Si es false, el producto no aparece en el punto de venta ni puede venderse por la API.
  available_for_sale         Boolean                   @default(true)
  /// Opt-in: si es true, cada ingreso de mercancía exige fecha de caducidad (lotes).
  tracks_expiry              Boolean                   @default(false)
  kind                       ProductKind               @default(STANDARD)
  /// Solo aplica a kits: si es true, el kit tiene stock propio real (se armó por adelantado) y ya no se calcula desde sus componentes.
  stock_assembled            Boolean                   @default(false)
  description                String?                   @db.Text
  deleted                    Boolean                   @default(false)
  deleted_at                 DateTime?
  status_id                  Int
  status                     StockStatus               @relation(fields: [status_id], references: [id])
  kit_components             ProductBomLine[]          @relation("KitParent")
  used_in_kits               ProductBomLine[]          @relation("KitComponent")
  alerts                     Alert[]
  sale_items                 SaleItem[]
  purchase_logs              PurchaseLog[]
  return_items               ReturnItem[]
  return_replacement_items   ReturnReplacementItem[]
  promotion_products         PromotionProduct[]
  incoming_merchandise_items IncomingMerchandiseItem[]
  inventory_count_lines      InventoryCountLine[]
  commercial_document_lines  CommercialDocumentLine[]
  stock_reservations         StockReservation[]
  lots                       ProductLot[]
  branch_stocks              ProductStock[]
  location_stocks            ProductStockLocation[]
  stock_movements            StockMovement[]
  transfer_lines             StockTransferLine[]

  @@unique([company_id, barcode])
  @@index([company_id])
  @@map("products")
}

/// Lote de producto con caducidad. Para productos con `tracks_expiry` la suma de
/// `qty_remaining` debe igualar la existencia; para el resto la cobertura es parcial
/// a propósito. `Product.stock` sigue siendo la
/// verdad para vender; los lotes se descuentan FEFO en segundo plano (trazabilidad + alertas).
model ProductLot {
  id                      String         @id @default(uuid()) @db.Uuid
  product_id              String         @db.Uuid
  product                 Product        @relation(fields: [product_id], references: [id])
  branch_id               String         @db.Uuid
  branch                  Branch         @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  /// Anaquel donde está el lote. Null = sin ubicación conocida (lote heredado):
  /// sigue contando para caducidad y puede despachar desde cualquiera.
  location_id             String?        @db.Uuid
  location                StockLocation? @relation(fields: [location_id], references: [id], onDelete: SetNull)
  /// Nº de lote del proveedor (opcional)
  lot_code                String?        @db.VarChar(60)
  /// Obligatoria vía API si product.tracks_expiry
  expiry_date             DateTime?      @db.Date
  qty_received            Int
  /// Restante según consumo FEFO. Con tracks_expiry es obligatorio que cuadre.
  qty_remaining           Int
  unit_cost               Decimal?       @db.Decimal(12, 2)
  supplier_id             String?        @db.Uuid
  /// Ingreso de mercancía que originó el lote (auditoría)
  incoming_merchandise_id String?        @db.Uuid
  received_at             DateTime       @default(now())

  @@index([product_id, expiry_date])
  @@index([product_id, location_id, expiry_date])
  @@index([expiry_date])
  @@index([branch_id])
  @@map("product_lots")
}

model ProductBomLine {
  id                   String  @id @default(uuid()) @db.Uuid
  kit_product_id       String  @db.Uuid
  kit_product          Product @relation("KitParent", fields: [kit_product_id], references: [id], onDelete: Cascade)
  component_product_id String  @db.Uuid
  component_product    Product @relation("KitComponent", fields: [component_product_id], references: [id], onDelete: Restrict)
  qty_per_unit         Int     @default(1)
  sort_order           Int     @default(0)

  @@unique([kit_product_id, component_product_id])
  @@index([kit_product_id], map: "idx_product_bom_lines_kit")
  @@index([component_product_id], map: "idx_product_bom_lines_component")
  @@map("product_bom_lines")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(50)
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

/// Sistema de permisos granular por rol
model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(150)
  description String?          @db.Text
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model User {
  id                                     String                            @id @default(uuid()) @db.Uuid
  name                                   String                            @db.VarChar(150)
  email                                  String                            @unique @db.VarChar(150)
  password                               String                            @db.VarChar(255)
  role_id                                Int
  role                                   Role                              @relation(fields: [role_id], references: [id])
  alerts                                 Alert[]                           @relation("AlertAssignedTo")
  incoming_merchandise                   IncomingMerchandise[]             @relation("MerchandiseRegisteredBy")
  /// Auditoría: última edición de datos de pago en un ingreso de mercancía
  incoming_merchandise_payment_updates   IncomingMerchandise[]             @relation("MerchandisePaymentAudit")
  /// Abonos parciales registrados en ingresos de mercancía
  merchandise_payment_entries_registered IncomingMerchandisePaymentEntry[] @relation("MerchandisePaymentEntryRegisteredBy")
  /// Cobros a clientes registrados (cuentas por cobrar)
  customer_payments_registered           CustomerPayment[]                 @relation("CustomerPaymentRegisteredBy")
  sales_created                          Sale[]                            @relation("SaleCreatedBy")
  cash_closures_as_cashier               CashClosure[]                     @relation("CashClosureCashier")
  cash_closures_as_supervisor            CashClosure[]                     @relation("CashClosureSupervisor")
  /// Sesiones de caja (apertura)
  cash_sessions_opened                   CashRegisterSession[]             @relation("CashSessionOpenedBy")
  cash_sessions_closed                   CashRegisterSession[]             @relation("CashSessionClosedBy")
  /// Caja asignada para POS (opcional; si es null usa la caja default)
  cash_register_id                       String?                           @db.Uuid
  cashRegister                           CashRegister?                     @relation("UserAssignedRegister", fields: [cash_register_id], references: [id], onDelete: SetNull)
  inventory_counts_created               InventoryCountSession[]           @relation("InventoryCountCreatedBy")
  inventory_counts_approved              InventoryCountSession[]           @relation("InventoryCountApprovedBy")
  inventory_counts_first_approved        InventoryCountSession[]           @relation("InventoryCountFirstApprovedBy")
  inventory_count_lines_counted          InventoryCountLine[]              @relation("InventoryCountLineCountedBy")
  inventory_count_lines_secondary_count  InventoryCountLine[]              @relation("InventoryCountLineSecondaryCountedBy")
  commercial_documents_created           CommercialDocument[]              @relation("CommercialDocCreatedBy")
  accounting_periods_closed              AccountingPeriod[]                @relation("PeriodClosedBy")
  journal_entries_created                JournalEntry[]                    @relation("JournalCreatedBy")
  employee_record                        Employee?                         @relation("EmployeeUser")
  employee_advances_created              EmployeeAdvance[]                 @relation("AdvanceCreatedBy")
  payroll_runs_created                   PayrollRun[]                      @relation("PayrollCreatedBy")
  payroll_runs_confirmed                 PayrollRun[]                      @relation("PayrollConfirmedBy")
  payroll_runs_cancelled                 PayrollRun[]                      @relation("PayrollCancelledBy")

  // Multi-empresa / sucursales
  user_companies     UserCompany[]
  user_branches      UserBranch[]
  /// Sucursal por defecto al entrar (si es null se usa la primera asignada)
  default_branch_id  String?         @db.Uuid
  defaultBranch      Branch?         @relation("UserDefaultBranch", fields: [default_branch_id], references: [id], onDelete: SetNull)
  transfers_created  StockTransfer[] @relation("TransferCreatedBy")
  transfers_received StockTransfer[] @relation("TransferReceivedBy")
  stock_movements    StockMovement[]

  // phone/address/hire_date/is_employee viven únicamente en Employee (RRHH);
  // ver [[employee_record]]. photo_url sí se queda: es el avatar de la cuenta,
  // no la foto de la ficha de empleado.
  photo_url  String?  @db.VarChar(500)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  refresh_tokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens rotatorios (uno por sesión). Se guarda sólo el hash SHA-256.
model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String    @db.Uuid
  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash  String    @unique @db.VarChar(64)
  expires_at  DateTime
  revoked_at  DateTime?
  replaced_by String?   @db.VarChar(64)
  created_at  DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

model Alert {
  id            String        @id @default(uuid()) @db.Uuid
  branch_id     String        @db.Uuid
  branch        Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  type_id       Int
  type          AlertType     @relation(fields: [type_id], references: [id])
  priority_id   Int
  priority      AlertPriority @relation(fields: [priority_id], references: [id])
  title         String        @db.VarChar(150)
  message       String?
  product_id    String        @db.Uuid
  product       Product       @relation(fields: [product_id], references: [id])
  current_stock Int?
  min_stock     Int?
  timestamp     DateTime      @default(now())
  status_id     Int
  status        Status        @relation(fields: [status_id], references: [id])
  assigned_to   String?       @db.Uuid
  assignedTo    User?         @relation(fields: [assigned_to], references: [id], name: "AlertAssignedTo")
  resolved      Int           @default(0)

  @@index([branch_id])
  @@map("alerts")
}

model Sale {
  id                String          @id @default(uuid()) @db.Uuid
  branch_id         String          @db.Uuid
  branch            Branch          @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  reference         String?         @db.VarChar(30) // Referencia legible: V-SUC1-000001 (generada al crear)
  date              DateTime        @default(now())
  customer          String?         @db.VarChar(150)
  customer_nit      String?         @db.VarChar(50)
  is_final_consumer Boolean         @default(true)
  subtotal          Decimal?        @db.Decimal(12, 2) // Total antes de descuentos
  discount_total    Decimal?        @db.Decimal(12, 2) // Total de descuentos aplicados
  total             Decimal         @db.Decimal(12, 2)
  total_returned    Decimal         @default(0) @db.Decimal(12, 2)
  adjusted_total    Decimal         @db.Decimal(12, 2)
  items             Int
  payment_method_id Int
  payment_method    PaymentMethod   @relation(fields: [payment_method_id], references: [id])
  status_id         Int
  status            SaleStatus      @relation(fields: [status_id], references: [id])
  amount_received   Decimal?        @db.Decimal(12, 2)
  change            Decimal?        @db.Decimal(12, 2)
  sale_items        SaleItem[]
  sale_dtes         SaleDte[] // Facturación DTE (InFile/SAT): autorización, serie, número
  returns           Return[]
  sale_promotions   SalePromotion[]
  sold_at           DateTime        @default(now())

  cash_register_session_id String?              @db.Uuid
  cashRegisterSession      CashRegisterSession? @relation(fields: [cash_register_session_id], references: [id], onDelete: SetNull)

  // Usuario que registró la venta
  created_by String? @db.Uuid
  createdBy  User?   @relation("SaleCreatedBy", fields: [created_by], references: [id])

  /// Cliente del maestro (Supplier party_type CUSTOMER), si se eligió en POS.
  customer_contact_id String?                 @db.Uuid
  customerContact     Supplier?               @relation("SaleCustomerContact", fields: [customer_contact_id], references: [id], onDelete: SetNull)
  sales_channel       SalesChannel            @default(POS)
  orderLink           CommercialDocumentSale?

  /// Clave del intento de cobro. Un doble clic o un reintento tras un timeout
  /// repite la misma y devuelve la venta que ya existe en vez de crear otra.
  idempotency_key String? @db.VarChar(64)

  /// Cuentas por cobrar. Solo tiene sentido en ventas al crédito; las de contado
  /// quedan en PAID (el default también deja correcto el histórico, que fue todo
  /// de contado). El saldo NO se guarda: es adjusted_total − Σ abonos.
  payment_status SalePaymentStatus  @default(PAID)
  due_date       DateTime?
  paymentEntries SalePaymentEntry[]

  @@unique([branch_id, reference])
  @@unique([branch_id, idempotency_key])
  @@index([created_by])
  @@index([cash_register_session_id])
  /// Listados por estado y fecha (p. ej. resumen de cliente, ventas «Completada»)
  @@index([status_id, date(sort: Desc)], map: "idx_sales_status_id_date_desc")
  @@index([branch_id, date(sort: Desc)])
  /// Estado de cuenta de un cliente y aplicación FIFO de sus abonos
  @@index([customer_contact_id, payment_status, due_date], map: "idx_sales_customer_payment_status_due")
  /// Antigüedad de saldos: barre solo lo que sigue abierto
  @@index([payment_status, due_date], map: "idx_sales_payment_status_due")
  @@map("sales")
}

// ========================================
// Cotizaciones y pedidos (documentos comerciales)
// ========================================

enum CommercialDocType {
  QUOTE
  ORDER
}

enum CommercialDocStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

enum StockReservationKind {
  ORDER
  QUOTE_SOFT
}

model CommercialDocument {
  id                  String                   @id @default(uuid()) @db.Uuid
  branch_id           String                   @db.Uuid
  branch              Branch                   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  reference           String?                  @db.VarChar(30)
  doc_type            CommercialDocType
  status              CommercialDocStatus      @default(DRAFT)
  valid_until         DateTime?
  customer            String?                  @db.VarChar(150)
  customer_nit        String?                  @db.VarChar(50)
  is_final_consumer   Boolean                  @default(true)
  customer_contact_id String?                  @db.Uuid
  customerContact     Supplier?                @relation("CommercialDocCustomer", fields: [customer_contact_id], references: [id], onDelete: SetNull)
  sales_channel       SalesChannel             @default(WHOLESALE)
  subtotal            Decimal?                 @db.Decimal(12, 2)
  discount_total      Decimal?                 @db.Decimal(12, 2)
  total               Decimal                  @db.Decimal(12, 2)
  notes               String?                  @db.Text
  converted_from_id   String?                  @db.Uuid
  convertedFrom       CommercialDocument?      @relation("CommercialDocConversion", fields: [converted_from_id], references: [id], onDelete: SetNull)
  convertedChildren   CommercialDocument[]     @relation("CommercialDocConversion")
  public_token        String?                  @unique @db.VarChar(64)
  created_by          String?                  @db.Uuid
  createdBy           User?                    @relation("CommercialDocCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  confirmed_at        DateTime?
  created_at          DateTime                 @default(now())
  updated_at          DateTime                 @updatedAt
  lines               CommercialDocumentLine[]
  stock_reservations  StockReservation[]
  documentSales       CommercialDocumentSale[]

  @@unique([branch_id, reference])
  @@index([doc_type, status, created_at(sort: Desc)], map: "idx_commercial_docs_type_status_created")
  @@index([customer_contact_id], map: "idx_commercial_docs_customer_contact")
  @@map("commercial_documents")
}

model CommercialDocumentLine {
  id            String             @id @default(uuid()) @db.Uuid
  document_id   String             @db.Uuid
  document      CommercialDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  product_id    String             @db.Uuid
  product       Product            @relation(fields: [product_id], references: [id])
  qty           Int
  qty_fulfilled Int                @default(0)
  unit_price    Decimal            @db.Decimal(12, 2)
  line_total    Decimal            @db.Decimal(12, 2)
  sort_order    Int                @default(0)
  reservations  StockReservation[]

  @@index([document_id], map: "idx_commercial_doc_lines_document")
  @@index([product_id], map: "idx_commercial_doc_lines_product")
  @@map("commercial_document_lines")
}

model StockReservation {
  id               String                 @id @default(uuid()) @db.Uuid
  product_id       String                 @db.Uuid
  product          Product                @relation(fields: [product_id], references: [id])
  branch_id        String                 @db.Uuid
  branch           Branch                 @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  document_id      String                 @db.Uuid
  document         CommercialDocument     @relation(fields: [document_id], references: [id], onDelete: Cascade)
  document_line_id String                 @db.Uuid
  document_line    CommercialDocumentLine @relation(fields: [document_line_id], references: [id], onDelete: Cascade)
  qty              Int
  status           StockReservationStatus @default(ACTIVE)
  reservation_kind StockReservationKind   @default(ORDER)
  expires_at       DateTime?
  created_by       String?                @db.Uuid
  created_at       DateTime               @default(now())
  released_at      DateTime?
  consumed_at      DateTime?

  @@index([product_id, status], map: "idx_stock_reservations_product_status")
  @@index([document_id, status], map: "idx_stock_reservations_document_status")
  @@index([branch_id, product_id, status])
  @@map("stock_reservations")
}

model CommercialDocumentSale {
  id          String             @id @default(uuid()) @db.Uuid
  document_id String             @db.Uuid
  document    CommercialDocument @relation(fields: [document_id], references: [id], onDelete: Cascade)
  sale_id     String             @unique @db.Uuid
  sale        Sale               @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  created_at  DateTime           @default(now())

  @@index([document_id], map: "idx_commercial_document_sales_document")
  @@map("commercial_document_sales")
}

model SaleDte {
  id            String    @id @default(uuid()) @db.Uuid
  sale_id       String    @db.Uuid
  sale          Sale      @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  document_type String?   @db.VarChar(50) // CFAC, CCRE, etc.
  authorization String?   @db.VarChar(100) // Número de autorización SAT
  series        String?   @db.VarChar(20)
  number        String?   @db.VarChar(50) // Número de factura
  emission_date DateTime? // Fecha de emisión
  status        String?   @db.VarChar(50) // autorizado, rechazado, etc.
  provider      String?   @db.VarChar(50) // InFile, etc.
  xml_url       String?   @db.VarChar(500)
  pdf_url       String?   @db.VarChar(500)
  created_at    DateTime  @default(now())

  @@index([sale_id])
  @@map("sale_dtes")
}

model SaleItem {
  id           Int          @id @default(autoincrement())
  sale_id      String       @db.Uuid
  sale         Sale         @relation(fields: [sale_id], references: [id])
  product_id   String       @db.Uuid
  product      Product      @relation(fields: [product_id], references: [id])
  price        Decimal      @db.Decimal(12, 2)
  /// Costo del producto AL MOMENTO DE VENDER. Sin esto el asiento contable toma
  /// el costo de hoy y editar un costo cambia el CMV de ventas viejas.
  /// Null = venta anterior a este campo; ahí se cae al costo del producto.
  unit_cost    Decimal?     @db.Decimal(12, 2)
  qty          Int
  return_items ReturnItem[]

  @@map("sale_items")
}

/// Distingue una compra operativa de una carga de saldo de apertura (nuevo
/// cliente/base). Ambos escriben en las mismas tablas (PurchaseLog,
/// IncomingMerchandise) porque comparten el mismo endpoint de entrada de
/// mercancía; sin esta marca los indicadores de "Compras del período" no
/// pueden excluir el inventario inicial.
enum MerchandiseSource {
  PURCHASE
  INITIAL
}

model PurchaseLog {
  id          Int               @id @default(autoincrement())
  product_id  String            @db.Uuid
  product     Product           @relation(fields: [product_id], references: [id])
  supplier_id String            @db.Uuid
  supplier    Supplier          @relation(fields: [supplier_id], references: [id])
  qty         Int
  date        DateTime          @default(now())
  cost        Decimal           @db.Decimal(12, 2)
  source      MerchandiseSource @default(PURCHASE)

  @@index([product_id])
  @@index([supplier_id, date(sort: Desc)], map: "idx_purchase_logs_supplier_date")
  @@map("purchase_logs")
}

/// Relación many-to-many entre proveedores y categorías de producto
model SupplierCategory {
  supplier_id String @db.Uuid
  category_id Int

  supplier Supplier        @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  category ProductCategory @relation(fields: [category_id], references: [id])

  @@id([supplier_id, category_id])
  @@map("supplier_categories")
}

/// Registro de auditoría para ingresos de mercancía
model IncomingMerchandise {
  id                 String                            @id @default(uuid()) @db.Uuid
  branch_id          String                            @db.Uuid
  branch             Branch                            @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  supplier_id        String                            @db.Uuid
  supplier           Supplier                          @relation(fields: [supplier_id], references: [id])
  registered_by      String                            @db.Uuid
  registeredBy       User                              @relation("MerchandiseRegisteredBy", fields: [registered_by], references: [id])
  date               DateTime                          @default(now())
  notes              String?                           @db.Text
  /// Término de pago acordado para esta compra (debe existir en los términos del proveedor al crear)
  payment_term_id    Int?
  paymentTerm        PaymentTerm?                      @relation(fields: [payment_term_id], references: [id], onDelete: SetNull)
  payment_status     MerchandisePaymentStatus          @default(PENDING)
  paid_at            DateTime?
  payment_reference  String?                           @db.VarChar(255)
  due_date           DateTime?
  payment_updated_by String?                           @db.Uuid
  paymentUpdatedBy   User?                             @relation("MerchandisePaymentAudit", fields: [payment_updated_by], references: [id], onDelete: SetNull)
  payment_updated_at DateTime?
  /// PURCHASE (default) = compra operativa; INITIAL = carga de saldo de
  /// apertura (nuevo cliente/base). Ver MerchandiseSource.
  source             MerchandiseSource                 @default(PURCHASE)
  items              IncomingMerchandiseItem[]
  paymentEntries     IncomingMerchandisePaymentEntry[]

  @@index([registered_by])
  @@index([date])
  @@index([payment_status])
  /// Cubre también filtro por supplier_id (prefijo del compuesto)
  @@index([supplier_id, date(sort: Desc)], map: "idx_incoming_merchandise_supplier_date")
  @@index([branch_id, date(sort: Desc)])
  @@map("incoming_merchandise")
}

model IncomingMerchandiseItem {
  id                      String              @id @default(uuid()) @db.Uuid
  incoming_merchandise_id String              @db.Uuid
  incomingMerchandise     IncomingMerchandise @relation(fields: [incoming_merchandise_id], references: [id], onDelete: Cascade)
  product_id              String              @db.Uuid
  product                 Product             @relation(fields: [product_id], references: [id])
  quantity                Int
  unit_cost               Decimal             @db.Decimal(12, 2)

  @@index([incoming_merchandise_id])
  @@index([product_id])
  @@map("incoming_merchandise_items")
}

/// Abono parcial hacia el total del ingreso (historial de pagos al proveedor)
model IncomingMerchandisePaymentEntry {
  id                      String              @id @default(uuid()) @db.Uuid
  incoming_merchandise_id String              @db.Uuid
  incomingMerchandise     IncomingMerchandise @relation(fields: [incoming_merchandise_id], references: [id], onDelete: Cascade)
  amount                  Decimal             @db.Decimal(12, 2)
  paid_at                 DateTime            @default(now())
  reference               String?             @db.VarChar(255)
  registered_by           String              @db.Uuid
  registeredBy            User                @relation("MerchandisePaymentEntryRegisteredBy", fields: [registered_by], references: [id])
  created_at              DateTime            @default(now())

  @@index([incoming_merchandise_id])
  @@map("incoming_merchandise_payment_entries")
}

// ========================================
// Cuentas por cobrar (clientes)
// ========================================

/// Recibo de cobro a un cliente. Se aplica FIFO a sus ventas al crédito abiertas,
/// generando un SalePaymentEntry por cada venta que alcanza a cubrir.
/// Espejo de IncomingMerchandisePaymentEntry, pero con un padre porque el cliente
/// paga «a cuenta» un monto que cruza varias facturas y se le entrega un recibo.
model CustomerPayment {
  id          String   @id @default(uuid()) @db.Uuid
  branch_id   String   @db.Uuid
  branch      Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  /// Cliente (Supplier con party_type CUSTOMER)
  customer_id String   @db.Uuid
  customer    Supplier @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  amount      Decimal  @db.Decimal(12, 2)
  paid_at     DateTime @default(now())

  payment_method_id Int
  payment_method    PaymentMethod @relation(fields: [payment_method_id], references: [id])

  /// Sesión de caja en la que se cobró. La necesita el arqueo para saber a qué
  /// turno pertenece el efectivo que entró por cobros y no por ventas.
  cash_register_session_id String?              @db.Uuid
  cashRegisterSession      CashRegisterSession? @relation(fields: [cash_register_session_id], references: [id], onDelete: SetNull)

  reference     String?  @db.VarChar(255)
  notes         String?  @db.Text
  registered_by String   @db.Uuid
  registeredBy  User     @relation("CustomerPaymentRegisteredBy", fields: [registered_by], references: [id])
  created_at    DateTime @default(now())

  applications SalePaymentEntry[]

  @@index([customer_id, paid_at(sort: Desc)])
  @@index([branch_id, paid_at(sort: Desc)])
  @@index([cash_register_session_id])
  @@index([registered_by])
  @@map("customer_payments")
}

/// Aplicación de un recibo de cobro contra una venta al crédito concreta.
model SalePaymentEntry {
  id                  String          @id @default(uuid()) @db.Uuid
  sale_id             String          @db.Uuid
  sale                Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  customer_payment_id String          @db.Uuid
  customerPayment     CustomerPayment @relation(fields: [customer_payment_id], references: [id], onDelete: Cascade)
  amount              Decimal         @db.Decimal(12, 2)
  created_at          DateTime        @default(now())

  @@index([sale_id])
  @@index([customer_payment_id])
  @@map("sale_payment_entries")
}

model Return {
  id               String       @id @default(uuid()) @db.Uuid
  sale_id          String       @db.Uuid
  sale             Sale         @relation(fields: [sale_id], references: [id])
  return_date      DateTime     @default(now())
  type             ReturnType   @default(REFUND)
  reason           String?      @db.Text
  total_refund     Decimal      @db.Decimal(12, 2)
  /// EXCHANGE: valor_reemplazo − valor_devuelto. + = cliente paga; − = se le devuelve.
  price_difference Decimal      @default(0) @db.Decimal(12, 2)
  items_count      Int          @default(0)
  status_id        Int
  status           ReturnStatus @relation(fields: [status_id], references: [id])
  processed_by     String?      @db.Uuid
  processed_at     DateTime?
  notes            String?      @db.Text

  return_items      ReturnItem[]
  replacement_items ReturnReplacementItem[]

  @@index([sale_id])
  @@index([status_id])
  @@map("returns")
}

model ReturnItem {
  id            Int      @id @default(autoincrement())
  return_id     String   @db.Uuid
  return        Return   @relation(fields: [return_id], references: [id])
  sale_item_id  Int
  sale_item     SaleItem @relation(fields: [sale_item_id], references: [id])
  product_id    String   @db.Uuid
  product       Product  @relation(fields: [product_id], references: [id])
  qty_returned  Int
  refund_amount Decimal  @db.Decimal(12, 2)
  reason        String?  @db.Text

  @@index([return_id])
  @@index([sale_item_id])
  @@index([product_id])
  @@map("return_items")
}

/// Productos que el cliente se lleva en un cambio (EXCHANGE). Descuentan stock al completar.
model ReturnReplacementItem {
  id         Int     @id @default(autoincrement())
  return_id  String  @db.Uuid
  return     Return  @relation(fields: [return_id], references: [id], onDelete: Cascade)
  product_id String  @db.Uuid
  product    Product @relation(fields: [product_id], references: [id])
  qty        Int
  unit_price Decimal @db.Decimal(12, 2)
  line_total Decimal @db.Decimal(12, 2)

  @@index([return_id])
  @@index([product_id])
  @@map("return_replacement_items")
}

// ========================================
// Caja registradora y sesiones (apertura)
// ========================================

/// Punto de cobro físico o lógico (hoy: una caja «Principal» por defecto; preparado para multi-caja).
model CashRegister {
  id         String   @id @default(uuid()) @db.Uuid
  branch_id  String   @db.Uuid
  branch     Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  name       String   @db.VarChar(120)
  code       String   @db.VarChar(40)
  is_default Boolean  @default(false)
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessions       CashRegisterSession[]
  /// Usuarios con esta caja asignada para POS
  assigned_users User[]                @relation("UserAssignedRegister")

  @@unique([branch_id, code])
  @@map("cash_registers")
}

enum CashRegisterSessionStatus {
  OPEN
  CLOSED
  VOID
}

/// Apertura de caja: una sesión OPEN por caja (índice único parcial en migración SQL).
model CashRegisterSession {
  id               String       @id @default(uuid()) @db.Uuid
  cash_register_id String       @db.Uuid
  cashRegister     CashRegister @relation(fields: [cash_register_id], references: [id], onDelete: Restrict)

  status       CashRegisterSessionStatus @default(OPEN)
  opened_at    DateTime                  @default(now())
  closed_at    DateTime?
  opened_by_id String                    @db.Uuid
  openedBy     User                      @relation("CashSessionOpenedBy", fields: [opened_by_id], references: [id], onDelete: Restrict)
  closed_by_id String?                   @db.Uuid
  closedBy     User?                     @relation("CashSessionClosedBy", fields: [closed_by_id], references: [id], onDelete: SetNull)

  opening_float Decimal @db.Decimal(12, 2)
  notes         String? @db.Text

  cash_closure_id String?      @unique @db.Uuid
  cashClosure     CashClosure? @relation(fields: [cash_closure_id], references: [id], onDelete: SetNull)

  sales             Sale[]
  customer_payments CustomerPayment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([cash_register_id, status])
  @@index([opened_by_id])
  @@map("cash_register_sessions")
}

// ========================================
// Cierre de Caja
// ========================================

model CashClosure {
  id             String   @id @default(uuid()) @db.Uuid
  /// Directo (no vía sesión) porque hay cierres legacy sin sesión de caja
  branch_id      String   @db.Uuid
  branch         Branch   @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  closure_number Int      @unique @default(autoincrement())
  date           DateTime @default(now())
  start_date     DateTime // Fecha/hora de inicio del período
  end_date       DateTime // Fecha/hora de fin del período

  // Usuario que genera el cierre
  cashier_name      String  @db.VarChar(100)
  cashier_signature String? @db.Text // Base64 de firma digital
  cashier_id        String? @db.Uuid
  cashier           User?   @relation("CashClosureCashier", fields: [cashier_id], references: [id], onDelete: SetNull)

  // Supervisor que valida
  supervisor_name         String?   @db.VarChar(100)
  supervisor_id           String?   @db.Uuid
  supervisor              User?     @relation("CashClosureSupervisor", fields: [supervisor_id], references: [id], onDelete: SetNull)
  supervisor_signature    String?   @db.Text // Base64 de firma digital
  supervisor_validated_at DateTime?

  /// Fondo inicial en caja al abrir el turno (solo arqueo por sesión)
  opening_float Decimal? @db.Decimal(12, 2)

  // Totales teóricos (según BD)
  theoretical_total   Decimal @db.Decimal(12, 2)
  theoretical_sales   Decimal @db.Decimal(12, 2)
  theoretical_returns Decimal @db.Decimal(12, 2)

  // Totales reales (conteo físico/validación)
  actual_total Decimal @db.Decimal(12, 2)

  // Diferencia
  difference            Decimal  @db.Decimal(12, 2) // actual - theoretical
  difference_percentage Decimal? @db.Decimal(5, 2)

  // Desglose por método de pago
  payment_breakdowns CashClosurePayment[]

  // Conteo de denominaciones (billetes/monedas)
  denominations CashClosureDenomination[]

  /// Sesión de apertura ligada a este cierre (si el cierre cerró una sesión abierta)
  cash_register_session CashRegisterSession?

  // Métricas adicionales
  total_transactions Int // Total de ventas en el período
  total_customers    Int // Total de clientes atendidos
  average_ticket     Decimal @db.Decimal(12, 2)

  // Notas y observaciones
  notes  String? @db.Text
  status String  @default("Pendiente") @db.VarChar(50) // Pendiente, Validado, Cerrado

  // Timestamps
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([date])
  @@index([status])
  @@index([cashier_id])
  @@index([supervisor_id])
  @@index([branch_id, date(sort: Desc)])
  @@map("cash_closures")
}

model CashClosurePayment {
  id              Int         @id @default(autoincrement())
  cash_closure_id String      @db.Uuid
  cash_closure    CashClosure @relation(fields: [cash_closure_id], references: [id], onDelete: Cascade)

  payment_method_id Int
  payment_method    PaymentMethod @relation(fields: [payment_method_id], references: [id])

  // Teórico (según BD)
  theoretical_amount Decimal @db.Decimal(12, 2)
  theoretical_count  Int // Cantidad de transacciones

  // Real (conteo/validación)
  actual_amount Decimal @db.Decimal(12, 2)
  actual_count  Int?

  // Diferencia
  difference Decimal @db.Decimal(12, 2)

  // Notas específicas por método
  notes String? @db.Text

  @@index([cash_closure_id])
  @@index([payment_method_id])
  @@map("cash_closure_payments")
}

model CashClosureDenomination {
  id              Int         @id @default(autoincrement())
  cash_closure_id String      @db.Uuid
  cash_closure    CashClosure @relation(fields: [cash_closure_id], references: [id], onDelete: Cascade)

  // Denominación (200, 100, 50, 20, 10, 5, 1, 0.50, 0.25, 0.10, 0.05, 0.01)
  denomination Decimal @db.Decimal(10, 2)
  type         String  @db.VarChar(20) // "Billete" o "Moneda"

  // Cantidad de unidades
  quantity Int

  // Subtotal (denomination * quantity)
  subtotal Decimal @db.Decimal(12, 2)

  @@index([cash_closure_id])
  @@map("cash_closure_denominations")
}

// ========================================
// Sistema de Promociones y Descuentos
// ========================================

model PromotionType {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(50)
  // Tipos: PERCENTAGE, FIXED_AMOUNT, BUY_X_GET_Y, COMBO_DISCOUNT, FREE_GIFT, MIN_QTY_DISCOUNT
  description String?     @db.Text
  promotions  Promotion[]

  @@map("promotion_types")
}

model Promotion {
  id          String        @id @default(uuid()) @db.Uuid
  company_id  String        @db.Uuid
  company     Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  name        String        @db.VarChar(150)
  description String?       @db.Text
  type_id     Int
  type        PromotionType @relation(fields: [type_id], references: [id])

  // Códigos vinculados (uno o varios)
  codes PromotionCode[]

  // Valores de la promoción
  discount_value      Decimal? @db.Decimal(12, 2) // Para FIXED_AMOUNT
  discount_percentage Decimal? @db.Decimal(5, 2) // Porcentaje (0-100)
  buy_quantity        Int? // Cantidad a comprar (2x1 = 2)
  get_quantity        Int? // Cantidad gratis (2x1 = 1)
  min_quantity        Int? // Cantidad mínima para aplicar

  // Sucursales donde aplica
  /// true = toda la empresa. false = solo las sucursales de `branches`.
  applies_to_all_branches Boolean           @default(true)
  branches                PromotionBranch[]

  // Productos relacionados
  applies_to_all        Boolean             @default(false) // Aplica a todos los productos
  trigger_product_id    String?             @db.Uuid // Producto que activa la promo
  target_product_id     String?             @db.Uuid // Producto que recibe el descuento/regalo
  applicable_products   PromotionProduct[]
  applicable_categories PromotionCategory[]

  // Validez y límites
  start_date            DateTime  @default(now())
  end_date              DateTime?
  max_uses              Int? // Usos máximos totales (por código)
  max_uses_per_customer Int? // Usos máximos por cliente
  min_purchase_amount   Decimal?  @db.Decimal(12, 2) // Compra mínima para aplicar

  // Estado
  active     Boolean  @default(true)
  deleted    Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  sale_promotions SalePromotion[]

  @@index([active, start_date, end_date])
  @@index([company_id])
  @@map("promotions")
}

// Códigos de promoción (permite múltiples códigos por promoción)
model PromotionCode {
  id           Int       @id @default(autoincrement())
  /// Denormalizado desde la promoción para unicidad del código por empresa
  company_id   String    @db.Uuid
  company      Company   @relation(fields: [company_id], references: [id], onDelete: Restrict)
  code         String    @db.VarChar(50)
  promotion_id String    @db.Uuid
  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  current_uses Int       @default(0)
  active       Boolean   @default(true)
  created_at   DateTime  @default(now())

  @@unique([company_id, code])
  @@index([promotion_id])
  @@map("promotion_codes")
}

/// Sucursales donde aplica la promoción (solo si applies_to_all_branches = false)
model PromotionBranch {
  promotion_id String    @db.Uuid
  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  branch_id    String    @db.Uuid
  branch       Branch    @relation(fields: [branch_id], references: [id], onDelete: Cascade)

  @@id([promotion_id, branch_id])
  @@index([branch_id])
  @@map("promotion_branches")
}

model PromotionProduct {
  id           Int       @id @default(autoincrement())
  promotion_id String    @db.Uuid
  promotion    Promotion @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  product_id   String    @db.Uuid
  product      Product   @relation(fields: [product_id], references: [id])

  @@unique([promotion_id, product_id])
  @@map("promotion_products")
}

model PromotionCategory {
  id           Int             @id @default(autoincrement())
  promotion_id String          @db.Uuid
  promotion    Promotion       @relation(fields: [promotion_id], references: [id], onDelete: Cascade)
  category_id  Int
  category     ProductCategory @relation(fields: [category_id], references: [id])

  @@unique([promotion_id, category_id])
  @@map("promotion_categories")
}

model SalePromotion {
  id               Int       @id @default(autoincrement())
  sale_id          String    @db.Uuid
  sale             Sale      @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  promotion_id     String    @db.Uuid
  promotion        Promotion @relation(fields: [promotion_id], references: [id])
  discount_applied Decimal   @db.Decimal(12, 2) // Monto efectivo descontado
  code_used        String?   @db.VarChar(50) // Código específico utilizado

  @@index([sale_id])
  @@index([promotion_id])
  @@map("sale_promotions")
}

// ========================================
// Inventariado (conteo físico vs stock teórico)
// ========================================

enum InventoryCountSessionStatus {
  DRAFT
  IN_PROGRESS
  IN_REVIEW
  PENDING_SECOND_APPROVAL
  APPROVED
  CANCELLED
}

model InventoryCountSession {
  id                    String                      @id @default(uuid()) @db.Uuid
  branch_id             String                      @db.Uuid
  branch                Branch                      @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  /// Acota el conteo a un almacén. Sin él, la sesión cubre toda la sucursal.
  warehouse_id          String?                     @db.Uuid
  warehouse             Warehouse?                  @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)
  name                  String?                     @db.VarChar(200)
  status                InventoryCountSessionStatus @default(DRAFT)
  /// Alcance y opciones: categoryIds?, supplierIds?, abcClasses? (A|B|C por valor en bodega),
  /// samplePercent? (1–99 muestreo aleatorio reproducible), doubleCount? (segunda lectura obligatoria)
  scope_json            Json?
  /// Si true: primera aprobación → PENDING_SECOND_APPROVAL; segunda aplica stock (otro usuario).
  dual_approval         Boolean                     @default(false)
  /// Motivo obligatorio al enviar a revisión
  submit_reason         String?                     @db.Text
  created_by_id         String                      @db.Uuid
  createdBy             User                        @relation("InventoryCountCreatedBy", fields: [created_by_id], references: [id])
  started_at            DateTime?
  submitted_at          DateTime?
  first_approved_at     DateTime?
  first_approved_by_id  String?                     @db.Uuid
  firstApprovedBy       User?                       @relation("InventoryCountFirstApprovedBy", fields: [first_approved_by_id], references: [id])
  first_approval_reason String?                     @db.Text
  final_approval_reason String?                     @db.Text
  approved_at           DateTime?
  approved_by_id        String?                     @db.Uuid
  approvedBy            User?                       @relation("InventoryCountApprovedBy", fields: [approved_by_id], references: [id])
  cancelled_at          DateTime?
  cancel_reason         String?                     @db.Text
  notes                 String?                     @db.Text
  lines                 InventoryCountLine[]
  created_at            DateTime                    @default(now())
  updated_at            DateTime                    @updatedAt

  @@index([created_by_id])
  @@index([created_at(sort: Desc)], map: "idx_inventory_count_sessions_created_at")
  /// Cubre filtro por status (prefijo) + orden por fecha del listado
  @@index([status, created_at(sort: Desc)], map: "idx_inventory_count_sessions_status_created")
  @@index([branch_id])
  @@map("inventory_count_sessions")
}

model InventoryCountLine {
  id                      String                @id @default(uuid()) @db.Uuid
  session_id              String                @db.Uuid
  session                 InventoryCountSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  product_id              String                @db.Uuid
  product                 Product               @relation(fields: [product_id], references: [id])
  /// Se cuenta ubicación por ubicación: un producto en dos anaqueles son dos líneas.
  location_id             String                @db.Uuid
  location                StockLocation         @relation(fields: [location_id], references: [id], onDelete: Restrict)
  stock_snapshot          Int
  qty_counted             Int?
  counted_at              DateTime?
  counted_by_id           String?               @db.Uuid
  countedBy               User?                 @relation("InventoryCountLineCountedBy", fields: [counted_by_id], references: [id])
  qty_counted_secondary   Int?
  counted_secondary_at    DateTime?
  counted_secondary_by_id String?               @db.Uuid
  countedSecondaryBy      User?                 @relation("InventoryCountLineSecondaryCountedBy", fields: [counted_secondary_by_id], references: [id])
  note                    String?               @db.VarChar(500)

  @@unique([session_id, product_id, location_id])
  @@index([session_id])
  @@index([product_id])
  @@map("inventory_count_lines")
}

// ========================================
// Configuración del sistema (módulo Configuración)
// ========================================

model SystemSetting {
  id          Int      @id @default(autoincrement())
  company_id  String   @db.Uuid
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  key         String   @db.VarChar(100)
  value       String   @db.Text
  type        String?  @db.VarChar(50) // string, json, number
  description String?  @db.VarChar(255)
  updated_at  DateTime @updatedAt

  @@unique([company_id, key])
  @@map("system_settings")
}

// ========================================
// Contabilidad (partida doble)
// ========================================

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  COST
  EXPENSE
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum JournalSourceType {
  MANUAL
  SALE
  RETURN
  PURCHASE
  PURCHASE_PAYMENT
  CLOSING
  /// Ajustes de inventario: manuales, diferencias de conteo y bajas de lote.
  /// Va al final: ADD VALUE lo agrega ahí y el orden del enum es el de la base.
  STOCK_ADJUSTMENT
  /// Nómina: devengo de la planilla al confirmarla, su pago, y los anticipos.
  /// Igual que arriba: al final, porque ADD VALUE los agrega ahí.
  PAYROLL
  PAYROLL_PAYMENT
  PAYROLL_ADVANCE
  /// Diferencia de arqueo (sobrante/faltante) al aprobar un cierre de caja.
  /// Igual que arriba: al final, porque ADD VALUE los agrega ahí.
  CASH_CLOSURE
  /// Cobro a un cliente: acredita Clientes contra Caja/Bancos. Cierra el
  /// circuito de la venta al crédito, que ya debitaba Clientes.
  /// Igual que arriba: al final, porque ADD VALUE los agrega ahí.
  SALE_PAYMENT
}

/// Cuenta contable (catálogo). `is_group` = agrupadora, no recibe movimientos.
model Account {
  id         Int           @id @default(autoincrement())
  company_id String        @db.Uuid
  company    Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  code       String        @db.VarChar(20)
  name       String        @db.VarChar(150)
  type       AccountType
  parent_id  Int?
  parent     Account?      @relation("AccountHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children   Account[]     @relation("AccountHierarchy")
  is_group   Boolean       @default(false)
  active     Boolean       @default(true)
  /// Usada por el posteo automático; no se puede desactivar ni eliminar
  system     Boolean       @default(false)
  lines      JournalLine[]

  @@unique([company_id, code])
  @@map("accounts")
}

model AccountingPeriod {
  id         Int                    @id @default(autoincrement())
  company_id String                 @db.Uuid
  company    Company                @relation(fields: [company_id], references: [id], onDelete: Restrict)
  year       Int
  month      Int
  status     AccountingPeriodStatus @default(OPEN)
  closed_at  DateTime?
  closed_by  String?                @db.Uuid
  closedBy   User?                  @relation("PeriodClosedBy", fields: [closed_by], references: [id], onDelete: SetNull)

  @@unique([company_id, year, month])
  @@map("accounting_periods")
}

/// Asiento contable. Inmutable una vez creado; se anula con contra-asiento.
model JournalEntry {
  id             String            @id @default(uuid()) @db.Uuid
  company_id     String            @db.Uuid
  company        Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  /// Sucursal que originó el asiento. NULL = asiento de empresa (manual, cierre anual, importación).
  branch_id      String?           @db.Uuid
  branch         Branch?           @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  entry_number   String            @db.VarChar(20) // A-000001
  date           DateTime
  description    String            @db.VarChar(255)
  source_type    JournalSourceType @default(MANUAL)
  source_id      String?           @db.VarChar(64)
  reversal_of_id String?           @db.Uuid
  reversalOf     JournalEntry?     @relation("EntryReversal", fields: [reversal_of_id], references: [id])
  reversals      JournalEntry[]    @relation("EntryReversal")
  created_by     String?           @db.Uuid
  createdBy      User?             @relation("JournalCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  created_at     DateTime          @default(now())
  lines          JournalLine[]

  /// Idempotencia del motor de posteo
  @@unique([company_id, source_type, source_id])
  @@unique([company_id, entry_number])
  @@index([date])
  @@index([branch_id])
  @@map("journal_entries")
}

model JournalLine {
  id          Int          @id @default(autoincrement())
  entry_id    String       @db.Uuid
  entry       JournalEntry @relation(fields: [entry_id], references: [id], onDelete: Cascade)
  account_id  Int
  account     Account      @relation(fields: [account_id], references: [id])
  debit       Decimal      @default(0) @db.Decimal(12, 2)
  credit      Decimal      @default(0) @db.Decimal(12, 2)
  description String?      @db.VarChar(255)

  @@index([entry_id])
  @@index([account_id])
  @@map("journal_lines")
}

// ========================================
// RRHH (expediente, asistencia, anticipos)
// ========================================

enum EmployeeStatus {
  ACTIVO
  SUSPENDIDO
  BAJA
}

enum ContractType {
  INDEFINIDO
  PLAZO_FIJO
  POR_OBRA
}

enum PayFrequency {
  MENSUAL
  QUINCENAL
}

enum EmployeePaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
}

enum AttendanceStatus {
  PRESENTE
  TARDE
  AUSENTE
  VACACIONES
  INCAPACIDAD
  PERMISO
  ASUETO
}

enum AdvanceStatus {
  PENDIENTE
  PAGADO
  CANCELADO
}

/// Expediente laboral. `user_id` es opcional: no todo empleado tiene login, y
/// borrar el login no borra el expediente.
model Employee {
  id                     String                @id @default(uuid()) @db.Uuid
  company_id             String                @db.Uuid
  company                Company               @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch_id              String                @db.Uuid
  branch                 Branch                @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  code                   String                @db.VarChar(20)
  /// Separados porque la planilla del IGSS los pide así
  first_name             String                @db.VarChar(100)
  last_name              String                @db.VarChar(100)
  dpi                    String?               @db.VarChar(20)
  nit                    String?               @db.VarChar(20)
  igss_number            String?               @db.VarChar(20)
  birth_date             DateTime?             @db.Date
  phone                  String?               @db.VarChar(50)
  email                  String?               @db.VarChar(150)
  address                String?               @db.Text
  photo_url              String?               @db.VarChar(500)
  position               String?               @db.VarChar(100)
  department             String?               @db.VarChar(100)
  hire_date              DateTime              @db.Date
  termination_date       DateTime?             @db.Date
  contract_type          ContractType          @default(INDEFINIDO)
  pay_frequency          PayFrequency          @default(MENSUAL)
  base_salary            Decimal               @default(0) @db.Decimal(12, 2)
  /// Decreto 78-89: no es salario para IGSS, indemnización, aguinaldo ni bono 14
  bonificacion_incentivo Decimal               @default(250) @db.Decimal(12, 2)
  payment_method         EmployeePaymentMethod @default(EFECTIVO)
  bank_name              String?               @db.VarChar(100)
  bank_account           String?               @db.VarChar(50)
  status                 EmployeeStatus        @default(ACTIVO)
  user_id                String?               @unique @db.Uuid
  user                   User?                 @relation("EmployeeUser", fields: [user_id], references: [id], onDelete: SetNull)
  created_at             DateTime              @default(now())
  updated_at             DateTime              @updatedAt

  attendance Attendance[]
  advances   EmployeeAdvance[]
  payslips   Payslip[]

  @@unique([company_id, code])
  @@index([branch_id])
  @@index([status])
  @@map("employees")
}

/// Marcaje diario. Informativo: no descuenta días del sueldo; su único efecto
/// sobre la nómina es pre-llenar las horas extra sugeridas del período.
model Attendance {
  id             String           @id @default(uuid()) @db.Uuid
  company_id     String           @db.Uuid
  company        Company          @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch_id      String           @db.Uuid
  branch         Branch           @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  employee_id    String           @db.Uuid
  employee       Employee         @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  work_date      DateTime         @db.Date
  check_in       String?          @db.VarChar(5)
  check_out      String?          @db.VarChar(5)
  hours          Decimal?         @db.Decimal(5, 2)
  overtime_hours Decimal          @default(0) @db.Decimal(5, 2)
  status         AttendanceStatus @default(PRESENTE)
  notes          String?          @db.Text
  created_at     DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  @@unique([employee_id, work_date])
  @@index([company_id, work_date])
  @@map("attendance")
}

/// Anticipo de sueldo. `balance` baja con cada cuota descontada en planilla y
/// se restituye exacto si la planilla se anula.
model EmployeeAdvance {
  id          String        @id @default(uuid()) @db.Uuid
  company_id  String        @db.Uuid
  company     Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch_id   String        @db.Uuid
  branch      Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  employee_id String        @db.Uuid
  employee    Employee      @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  date        DateTime      @db.Date
  amount      Decimal       @db.Decimal(12, 2)
  /// Cuota a descontar por planilla ordinaria
  installment Decimal       @db.Decimal(12, 2)
  /// Saldo pendiente; arranca en `amount`
  balance     Decimal       @db.Decimal(12, 2)
  reason      String?       @db.Text
  status      AdvanceStatus @default(PENDIENTE)
  created_by  String?       @db.Uuid
  createdBy   User?         @relation("AdvanceCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  payslip_lines PayslipLine[]

  @@index([employee_id, status])
  @@index([company_id, status])
  @@map("employee_advances")
}

// ========================================
// Nómina (planillas, recibos y conceptos)
// ========================================

enum PayrollType {
  ORDINARIA
  AGUINALDO
  BONO14
}

enum PayrollStatus {
  BORRADOR
  CONFIRMADA
  PAGADA
  ANULADA
}

enum PayslipLineType {
  DEVENGO
  DEDUCCION
  COSTO_PATRONAL
}

enum PayrollConcept {
  SUELDO_ORDINARIO
  BONIFICACION_INCENTIVO
  HORAS_EXTRA
  AGUINALDO
  BONO14
  OTRO_DEVENGO
  IGSS_LABORAL
  ISR_RETENIDO
  ANTICIPO
  OTRA_DEDUCCION
  IGSS_PATRONAL
  IRTRA
  INTECAP
  PROVISION_AGUINALDO
  PROVISION_BONO14
  PROVISION_VACACIONES
  PROVISION_INDEMNIZACION
}

/// Corrida de planilla. Los totales están denormalizados para no recorrer los
/// recibos en cada listado.
model PayrollRun {
  id                  String        @id @default(uuid()) @db.Uuid
  company_id          String        @db.Uuid
  company             Company       @relation(fields: [company_id], references: [id], onDelete: Restrict)
  branch_id           String        @db.Uuid
  branch              Branch        @relation(fields: [branch_id], references: [id], onDelete: Restrict)
  /// Correlativo por empresa y mes: NOM-2026-08-001
  code                String        @db.VarChar(20)
  name                String        @db.VarChar(150)
  type                PayrollType   @default(ORDINARIA)
  period_start        DateTime      @db.Date
  period_end          DateTime      @db.Date
  pay_date            DateTime      @db.Date
  status              PayrollStatus @default(BORRADOR)
  total_earnings      Decimal       @default(0) @db.Decimal(14, 2)
  total_deductions    Decimal       @default(0) @db.Decimal(14, 2)
  total_net           Decimal       @default(0) @db.Decimal(14, 2)
  total_employer_cost Decimal       @default(0) @db.Decimal(14, 2)
  notes               String?       @db.Text
  created_by          String?       @db.Uuid
  createdBy           User?         @relation("PayrollCreatedBy", fields: [created_by], references: [id], onDelete: SetNull)
  confirmed_by        String?       @db.Uuid
  confirmedBy         User?         @relation("PayrollConfirmedBy", fields: [confirmed_by], references: [id], onDelete: SetNull)
  cancelled_by        String?       @db.Uuid
  cancelledBy         User?         @relation("PayrollCancelledBy", fields: [cancelled_by], references: [id], onDelete: SetNull)
  confirmed_at        DateTime?
  paid_at             DateTime?
  cancelled_at        DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  payslips Payslip[]

  @@unique([company_id, code])
  @@index([branch_id, status])
  @@index([company_id, pay_date])
  @@map("payroll_runs")
}

/// Recibo de un empleado en una corrida. Congela el cálculo: subirle el sueldo
/// a alguien no cambia una planilla ya emitida.
model Payslip {
  id               String     @id @default(uuid()) @db.Uuid
  run_id           String     @db.Uuid
  run              PayrollRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  employee_id      String     @db.Uuid
  employee         Employee   @relation(fields: [employee_id], references: [id], onDelete: Restrict)
  /// Snapshot del sueldo al momento de calcular
  base_salary      Decimal    @db.Decimal(12, 2)
  /// Días de mes comercial (30) que corresponden al tramo contratado
  days_worked      Decimal    @db.Decimal(5, 2)
  /// Bases para la planilla del IGSS y el reporte de retenciones de la SAT
  igss_base        Decimal    @default(0) @db.Decimal(12, 2)
  isr_base         Decimal    @default(0) @db.Decimal(12, 2)
  total_earnings   Decimal    @default(0) @db.Decimal(12, 2)
  total_deductions Decimal    @default(0) @db.Decimal(12, 2)
  net_pay          Decimal    @default(0) @db.Decimal(12, 2)
  employer_cost    Decimal    @default(0) @db.Decimal(12, 2)

  lines PayslipLine[]

  @@unique([run_id, employee_id])
  @@index([employee_id])
  @@map("payslips")
}

/// Desglose auditable del recibo. El signo lo da `type`, el importe siempre es
/// positivo.
model PayslipLine {
  id          String           @id @default(uuid()) @db.Uuid
  payslip_id  String           @db.Uuid
  payslip     Payslip          @relation(fields: [payslip_id], references: [id], onDelete: Cascade)
  concept     PayrollConcept
  type        PayslipLineType
  description String           @db.VarChar(150)
  quantity    Decimal?         @db.Decimal(10, 2)
  amount      Decimal          @db.Decimal(12, 2)
  /// Si es cuota de anticipo: permite restituir el saldo EXACTO al anular
  advance_id  String?          @db.Uuid
  advance     EmployeeAdvance? @relation(fields: [advance_id], references: [id], onDelete: SetNull)
  sort_order  Int              @default(0)

  @@index([payslip_id])
  @@index([advance_id])
  @@map("payslip_lines")
}
