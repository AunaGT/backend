await (async (page) => { const results=[];const errors=[];page.on('pageerror',e=>errors.push(e.message)); for(const mode of ['list','detail','create','result','review']) { await page.goto('http://127.0.0.1:43365/disputes-preview.html?mode='+mode); if(mode==='list')await page.getByRole('link',{name:'CB-2026-0142'}).waitFor();else if(mode==='create')await page.locator('#dispute-reference').waitFor();else if(mode==='result')await page.getByRole('combobox',{name:'Resultado del reclamo'}).waitFor();else if(mode==='review')await page.getByText('Preparada por Andrea Gómez',{exact:false}).waitFor();else await page.getByRole('tab',{name:'Contabilidad',exact:true}).waitFor(); for(const width of [375,768,1440,1920]) { await page.setViewportSize({width,height:900}); for(const dark of [false,true]) { await page.evaluate(dark=>document.documentElement.classList.toggle('dark',dark),dark); await page.screenshot({path:'output/qa/cash-disputes/'+mode+'-'+width+'-'+(dark?'dark':'light')+'.png',fullPage:true}); const overflow=await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth);results.push({mode,width,dark,overflow});if(overflow)throw Error('Overflow: '+mode+' '+width); } } } if(errors.length)throw Error(errors.join('; ')); return {views:results.length,overflow:results.filter(r=>r.overflow),pageErrors:errors}; })(page);
