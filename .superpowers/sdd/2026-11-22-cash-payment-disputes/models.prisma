generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

// Disputas: documentos nuevos; las FKs de alcance e inmutabilidad viven en la migración.
model CashPaymentDispute {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  event_id String @db.Uuid
  customer_id String? @db.Uuid
  payment_method_id Int
  currency_code String @db.VarChar(3)
  claimed Decimal @db.Decimal(12,2)
  provider_reference String @db.VarChar(120)
  provider_reference_key String @db.VarChar(240)
  reason String @db.VarChar(1000)
  deadline DateTime? @db.Date
  status String @default("OPEN") @db.VarChar(24)
  version Int @default(1)
  won Decimal @default(0) @db.Decimal(12,2)
  lost Decimal @default(0) @db.Decimal(12,2)
  created_by_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([company_id,payment_method_id,provider_reference_key],map:"cash_dispute_provider_reference")
  @@unique([company_id,branch_id,id],map:"cash_dispute_scope_key")
  @@index([event_id])
  @@index([company_id,branch_id,created_at(sort:Desc)])
  @@map("cash_payment_disputes")
}
model CashDisputeEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispute_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  kind String @db.VarChar(32)
  principal Decimal @default(0) @db.Decimal(12,2)
  fee Decimal @default(0) @db.Decimal(12,2)
  reference String? @db.VarChar(255)
  evidence Json @default("{}")
  payload Json @default("{}")
  economic_on DateTime? @db.Date
  accounting_on DateTime? @db.Date
  reversal_of_id String? @db.Uuid
  settlement_id String? @db.Uuid
  deduction_id String? @unique @db.Uuid
  journal_entry_id String? @db.Uuid
  accounting_status String @default("DEFERRED") @db.VarChar(16)
  actor_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([company_id,branch_id,dispute_id,id],map:"cash_dispute_event_scope_key")
  @@index([dispute_id,created_at])
  @@map("cash_dispute_events")
}
model CashDisputeProposal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispute_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  kind String @db.VarChar(24)
  payload Json
  preview_key String @db.VarChar(64)
  expected_version Int
  status String @default("PENDING") @db.VarChar(16)
  proposed_by_id String @db.Uuid
  proposed_at DateTime @default(now()) @db.Timestamptz(3)
  decided_by_id String? @db.Uuid
  decided_at DateTime? @db.Timestamptz(3)
  decision_reason String? @db.VarChar(1000)
  self_review Boolean @default(false)
  @@unique([company_id,branch_id,dispute_id,id],map:"cash_dispute_proposal_scope_key")
  @@index([dispute_id,status])
  @@map("cash_dispute_proposals")
}
model CashDisputeCommand {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  actor_id String @db.Uuid
  action String @db.VarChar(40)
  request_key String @db.Uuid
  content_hash String @db.VarChar(64)
  result Json
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([company_id,branch_id,actor_id,action,request_key],map:"cash_dispute_command_attempt")
  @@map("cash_dispute_commands")
}
model CashDisputeLot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispute_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  proposal_id String? @db.Uuid
  event_id String? @db.Uuid
  target_lot_id String? @db.Uuid
  kind String @db.VarChar(24)
  principal Decimal @db.Decimal(12,2)
  account_id Int?
  payload Json @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([company_id,branch_id,dispute_id,id],map:"cash_dispute_lot_scope_key")
  @@index([dispute_id])
  @@index([target_lot_id])
  @@map("cash_dispute_lots")
}
model CustomerReceiptRestriction {
  payment_id String @db.Uuid
  dispute_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String @db.Uuid
  held Decimal @default(0) @db.Decimal(12,2)
  retired Decimal @default(0) @db.Decimal(12,2)
  version Int @default(1)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  @@id([payment_id,dispute_id])
  @@index([company_id,branch_id,customer_id])
  @@map("customer_receipt_restrictions")
}
model CustomerDisputeCharge {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispute_id String @db.Uuid
  lot_id String @unique @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String @db.Uuid
  currency_code String @db.VarChar(3)
  reference String @db.VarChar(40)
  amount Decimal @db.Decimal(12,2)
  issued_on DateTime @db.Date
  due_on DateTime @db.Date
  reason String @db.VarChar(1000)
  created_by_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([company_id,branch_id,customer_id,id],map:"customer_dispute_charge_scope_key")
  @@unique([company_id,reference])
  @@index([customer_id,due_on])
  @@map("customer_dispute_charges")
}
model CustomerDisputeChargeApplication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  charge_id String @db.Uuid
  payment_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  action String @default("APPLY") @db.VarChar(16)
  reversal_of_id String? @db.Uuid
  actor_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@index([charge_id])
  @@index([payment_id])
  @@map("customer_dispute_charge_applications")
}
model CustomerRecoveryCredit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dispute_id String @db.Uuid
  event_id String @db.Uuid
  lot_id String @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String @db.Uuid
  currency_code String @db.VarChar(3)
  amount Decimal @db.Decimal(12,2)
  actor_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@unique([event_id,lot_id])
  @@unique([company_id,branch_id,customer_id,id],map:"customer_recovery_credit_scope_key")
  @@index([customer_id])
  @@map("customer_recovery_credits")
}
model CustomerRecoveryCreditApplication {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  credit_id String @db.Uuid
  sale_id String? @db.Uuid
  charge_id String? @db.Uuid
  company_id String @db.Uuid
  branch_id String @db.Uuid
  customer_id String @db.Uuid
  amount Decimal @db.Decimal(12,2)
  action String @default("APPLY") @db.VarChar(16)
  reversal_of_id String? @db.Uuid
  actor_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(3)
  @@index([credit_id])
  @@index([sale_id])
  @@index([charge_id])
  @@map("customer_recovery_credit_applications")
}
model CashDisputeSettings {
  company_id String @id @db.Uuid
  owner_self_review Boolean @default(false)
  dispute_account_id Int?
  loss_account_id Int?
  fee_account_id Int?
  receivables_account_id Int?
  advances_account_id Int?
  revision Int @default(1)
  updated_by_id String @db.Uuid
  reason String @db.VarChar(1000)
  updated_at DateTime @default(now()) @db.Timestamptz(3)
  @@map("cash_dispute_settings")
}
